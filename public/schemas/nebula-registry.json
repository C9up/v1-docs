{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://r-eam.com/schemas/nebula-registry.json",
  "title": "nebula registry",
  "description": "The components @c9up/nebula can copy into an application (registry.json, generated by `pnpm registry`).",
  "type": "object",
  "required": ["name", "items"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "description": "The package the sources are copied from." },
    "homepage": { "type": "string", "format": "uri" },
    "layout": {
      "const": "mirror",
      "description": "Copies mirror the package's src/ tree, so no import is rewritten."
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "title", "layer", "files", "dependencies"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "title": { "type": "string" },
          "layer": { "enum": ["atoms", "molecules", "organisms", "templates"] },
          "files": {
            "type": "array",
            "items": { "type": "string", "description": "A path relative to the package's src/." }
          },
          "dependencies": {
            "type": "array",
            "items": { "type": "string", "description": "The name of another item of this registry." }
          }
        }
      }
    }
  }
}
