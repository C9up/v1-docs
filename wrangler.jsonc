{
  // The docs as static assets on Cloudflare Workers: no script runs, the
  // built VitePress site is served from Cloudflare's edge.
  "name": "ream-docs",
  "account_id": "5e2eb2976fd458f98840e79d9a653aad",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": ".vitepress/dist",
    // /fr/guide/websockets serves websockets.html
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
